---
import { withBase } from '../../core/site/base-path';
import { CATEGORIES } from '../../core/population/category';
import Search from '../components/Search.astro';
import Base from '../layouts/Base.astro';
import { getContent } from '../lib/content';

const { navigation } = getContent();
const base = import.meta.env.BASE_URL;
const visible = navigation.visibleRoots();
const upcoming = navigation.roots().filter((root) => !navigation.isVisible(root.id));
const missing = CATEGORIES.filter(({ id }) => !visible.some((root) => navigation.categories(root.id).includes(id)));
---

<Base title="Valvia">
  <h1>Echo reference values</h1>
  <p class="lead">
    Cut-off and reference values from ESC (incl. EACVI) and ASE documents, each with its source. Where societies
    disagree, both values are shown.
  </p>

  <Search />

  <section class="recent" data-recent hidden aria-labelledby="recent-heading">
    <div class="recent__header">
      <h2 id="recent-heading">Recently viewed</h2>
      <button type="button" class="recent__clear" data-recent-clear>
        Clear
      </button>
    </div>
    <ol></ol>
    <p class="recent__note">Stored on this device only.</p>
  </section>

  <section aria-labelledby="categories-heading">
    <h2 id="categories-heading" class="visually-hidden">
      Categories
    </h2>
    <ul class="category-grid">
      {visible.map((root) => {
        return (
          <li data-categories={navigation.categories(root.id).join(' ')}>
            <a class="category-card" href={withBase(base, navigation.urlPath(root.id))}>
              <span class="category-card__title">{root.title}</span>
              {CATEGORIES.map(({ id }) => {
                const inCategory = navigation.leafCountIn(root.id, id);
                return (
                  inCategory > 0 && (
                    <span class="category-card__meta" data-count-for={id}>
                      {inCategory} {inCategory === 1 ? 'topic' : 'topics'}
                    </span>
                  )
                );
              })}
            </a>
          </li>
        );
      })}
    </ul>
    {missing.map(({ id, label }) => (
      <p class="category-notice" data-category-notice={id}>
        No {label} values yet; this category is in preparation.
      </p>
    ))}
  </section>

  {upcoming.length > 0 && (
    <section aria-labelledby="upcoming-heading" class="upcoming">
      <h2 id="upcoming-heading">In preparation</h2>
      <ul>
        {upcoming.map((root) => (
          <li>{root.title}</li>
        ))}
      </ul>
    </section>
  )}
</Base>
