---
import type { LoadedTopic } from '../../core/content/types';
import AlgorithmReference from '../components/AlgorithmReference.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CriteriaChecklist from '../components/CriteriaChecklist.astro';
import GradingTable from '../components/GradingTable.astro';
import JumpMenu from '../components/JumpMenu.astro';
import SocietyFilter from '../components/SocietyFilter.astro';
import Comparisons from '../components/Comparisons.astro';
import PreviousRecommendations from '../components/PreviousRecommendations.astro';
import ReportLink from '../components/ReportLink.astro';
import SourceChips from '../components/SourceChips.astro';
import ThresholdList from '../components/ThresholdList.astro';
import TopicList from '../components/TopicList.astro';
import Base from '../layouts/Base.astro';
import { parameterAnchorBlocks } from '../../core/navigation/anchors';
import { blockHeading } from '../../core/navigation/block-heading';
import { searchTerms } from '../../core/navigation/search-terms';
import { reviewStatus } from '../../core/site/version';
import { differingValues, leafView } from '../../core/view/leaf';
import { getContent } from '../lib/content';
import { CATEGORIES, sortCategories } from '../../core/population/category';

export function getStaticPaths() {
  const { navigation } = getContent();
  return navigation.visibleNodes().map((topic) => ({
    params: { path: navigation.urlPath(topic.id).replace(/\/$/, '') },
    props: { topic },
  }));
}

interface Props {
  topic: LoadedTopic;
}
const { topic } = Astro.props;
const { bundle, navigation } = getContent();
const indexed = navigation.hasContent(topic.id);
const terms = indexed ? searchTerms(topic, bundle.parameters) : [];
const context = navigation
  .ancestors(topic.id)
  .map((node) => node.title)
  .join(' › ');
const children = navigation.visibleChildren(topic.id);
const blocks = topic.blocks ?? [];
const review = reviewStatus(topic);
const sections = leafView(topic, bundle);
const anchors = parameterAnchorBlocks(sections.filter((s) => !s.noCurrentValue).map((s) => s.block));
const pageCategories = sortCategories(sections.flatMap((s) => s.categories));
const presentLabels = CATEGORIES.filter(({ id }) => pageCategories.includes(id)).map(({ label }) => label);
const missingCategories =
  pageCategories.length === 0 ? [] : CATEGORIES.filter(({ id }) => !pageCategories.includes(id));
---

<Base title={topic.title}>
  <Breadcrumbs topic={topic} />
  <article
    data-pagefind-body={indexed ? '' : undefined}
    data-pagefind-meta={indexed ? `context:${context}` : undefined}
    data-recent-path={blocks.length > 0 ? navigation.urlPath(topic.id) : undefined}
    data-recent-title={blocks.length > 0 ? topic.title : undefined}
  >
    <h1 data-pagefind-meta="title">{topic.title}</h1>
    {blocks.length > 0 && (
      <p class:list={['review-status', { 'review-status--draft': !review.reviewed }]} data-pagefind-ignore>
        {review.label}
      </p>
    )}
    {terms.length > 0 && (
      <p class="visually-hidden" aria-hidden="true" data-pagefind-weight="5">
        {terms.join(' · ')}
      </p>
    )}
    {children.length > 0 && <TopicList topics={children} />}
    {missingCategories.map(({ id, label }) => (
      <p class="category-notice" data-category-notice={id}>
        No {label} values on this page yet. Values here are for: {presentLabels.join(', ')}.
      </p>
    ))}
    {blocks.length > 0 && <SocietyFilter />}
    <JumpMenu blocks={blocks} />
    {sections.map((section) => {
      const { block, history, noCurrentValue, categories, comparisons } = section;
      const differing = differingValues(section);
      const heading = blockHeading(block);
      return (
        <section
          class="block"
          id={block.id}
          aria-labelledby={`${block.id}-heading`}
          data-categories={categories.length > 0 ? categories.join(' ') : undefined}
        >
          <h2 id={`${block.id}-heading`}>{heading}</h2>
          <SourceChips block={block} />
          {noCurrentValue && <p class="gap">No current society-endorsed value.</p>}
          {!noCurrentValue && (block.type === 'grading-table' || block.type === 'normal-range-table') && (
            <GradingTable block={block} label={heading} differing={differing} anchors={anchors} />
          )}
          {!noCurrentValue && block.type === 'threshold-list' && (
            <ThresholdList block={block} label={heading} differing={differing} anchors={anchors} />
          )}
          {block.type === 'criteria-checklist' && <CriteriaChecklist block={block} />}
          {block.type === 'note' && <p class="note">{block.text}</p>}
          {block.type === 'algorithm-reference' && <AlgorithmReference block={block} />}
          <Comparisons comparisons={comparisons} />
          <PreviousRecommendations items={history} />
          <ReportLink topic={topic.title} section={heading} anchor={block.id} />
        </section>
      );
    })}
  </article>
</Base>
