---
import type { LoadedTopic } from '../../core/content/types';
import AlgorithmReference from '../components/AlgorithmReference.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CriteriaChecklist from '../components/CriteriaChecklist.astro';
import GradingTable from '../components/GradingTable.astro';
import TopicList from '../components/TopicList.astro';
import Base from '../layouts/Base.astro';
import { getContent } from '../lib/content';

export function getStaticPaths() {
  const { navigation } = getContent();
  return navigation.visibleNodes().map((topic) => ({
    params: { path: navigation.urlPath(topic.id).replace(/\/$/, '') },
    props: { topic },
  }));
}

interface Props {
  topic: LoadedTopic;
}
const { topic } = Astro.props;
const { navigation } = getContent();
const children = navigation.visibleChildren(topic.id);
const blocks = topic.blocks ?? [];
---

<Base title={topic.title}>
  <Breadcrumbs topic={topic} />
  <h1>{topic.title}</h1>
  {children.length > 0 && <TopicList topics={children} />}
  {blocks.map((block) => {
    const heading = block.title ?? block.id;
    return (
      <section class="block" id={block.id} aria-labelledby={`${block.id}-heading`}>
        <h2 id={`${block.id}-heading`}>{heading}</h2>
        {block.type === 'grading-table' && <GradingTable block={block} label={heading} />}
        {block.type === 'criteria-checklist' && <CriteriaChecklist block={block} />}
        {block.type === 'note' && <p class="note">{block.text}</p>}
        {block.type === 'algorithm-reference' && <AlgorithmReference block={block} />}
      </section>
    );
  })}
</Base>
