---
import { withBase } from '../../core/site/base-path';

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found · Valvia</title>
  </head>
  <body>
    <main>
      <h1>Page not found</h1>
      <p>This page does not exist or has moved.</p>
      <p>
        <a href={withBase(base, '/')}>Go to the Valvia home page</a>
      </p>
    </main>
  </body>
</html>
