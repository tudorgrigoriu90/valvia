---
import { modalityBadge } from '../../core/values/modality-badge';
import { valueCategory } from '../../core/population/category';
import { societiesOf } from '../../core/values/society';
import { getContent } from '../lib/content';
import type { TableValue } from '../../core/values/table';

interface Props {
  entry: TableValue;
  text?: string;
  blockId: string;
  differs?: boolean;
}
const { entry, text = entry.text, blockId, differs = false } = Astro.props;
const badge = modalityBadge(entry.value.modality);
const source = getContent().bundle.sources.get(entry.value.citation.source);
const societies = societiesOf(source?.issuers ?? []).join(' ');
---

<span class="value" data-value-category={valueCategory(entry.value)} data-societies={societies}>
  {text}
  {differs && (
    <span class="differs-marker" title="Differs between sources">
      ≠<span class="visually-hidden"> (differs between sources)</span>
    </span>
  )}
  {badge !== undefined && (
    <span class="modality-badge" title={badge.description}>
      {badge.label}
      <span class="visually-hidden"> ({badge.description})</span>
    </span>
  )}
  {entry.footnotes.map((n) => (
    <sup>
      <a href={`#${blockId}-fn-${String(n)}`} aria-label={`Footnote ${String(n)}`}>
        {n}
      </a>
    </sup>
  ))}
</span>
