---
import { modalityBadge } from '../../core/values/modality-badge';
import type { TableValue } from '../../core/values/table';

interface Props {
  entry: TableValue;
  text?: string;
  blockId: string;
}
const { entry, text = entry.text, blockId } = Astro.props;
const badge = modalityBadge(entry.value.modality);
---

<span class="value">
  {entry.converted ? (
    <details class="original">
      <summary>{text}</summary>
      <span class="original__body">Published as {entry.original}</span>
    </details>
  ) : (
    text
  )}
  {badge !== undefined && (
    <span class="modality-badge" title={badge.description}>
      {badge.label}
      <span class="visually-hidden"> ({badge.description})</span>
    </span>
  )}
  {entry.footnotes.map((n) => (
    <sup>
      <a href={`#${blockId}-fn-${String(n)}`} aria-label={`Footnote ${String(n)}`}>
        {n}
      </a>
    </sup>
  ))}
</span>
