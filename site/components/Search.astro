---
/** Search box (TS-04.4.2). Hidden until the script runs; a notice explains that search needs JavaScript. */
---

<form class="search" role="search" aria-label="Search topics and parameters" data-search hidden>
  <label for="search-input" class="search__label">
    Search
  </label>
  <input
    id="search-input"
    type="search"
    name="q"
    placeholder="EROA, PISA, TAPSE…"
    autocomplete="off"
    autocapitalize="off"
    spellcheck="false"
    enterkeyhint="search"
  />
  <p class="search__status" data-search-status aria-live="polite"></p>
  <ul class="search-results" data-search-results></ul>
</form>
<noscript>
  <p class="search__noscript">Search needs JavaScript; browse the categories below.</p>
</noscript>

<script>
  import '../scripts/search';
</script>
