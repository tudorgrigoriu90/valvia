---
import type { LoadedValue } from '../../core/content/types';
import { rowAnchors } from '../../core/navigation/anchors';
import type { ValueTable } from '../../core/values/table';
import Footnotes from './Footnotes.astro';
import ValueText from './ValueText.astro';

interface Props {
  table: ValueTable;
  label: string;
  blockId: string;
  differing?: ReadonlySet<LoadedValue>;
  anchors?: ReadonlyMap<string, string>;
}
const { table, label, blockId, differing = new Set<LoadedValue>(), anchors = new Map<string, string>() } = Astro.props;
const rowIds = rowAnchors(
  table.rows.map((row) => row.parameter.id),
  blockId,
  anchors,
);
---

<div class="table-scroll" role="region" aria-label={`${label} (scrollable table)`} tabindex="0">
  <table class="grading-table" aria-label={label}>
    <thead>
      <tr>
        <th scope="col">Parameter</th>
        {table.columns.map((column) => (
          <th scope="col">{column}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {table.rows.map((row, index) => (
        <tr id={rowIds[index]}>
          <th scope="row">
            <abbr title={row.name}>{row.label}</abbr>
            {row.population !== '' && <span class="population">{row.population}</span>}
            {row.unit !== undefined && <span class="unit">{row.unit}</span>}
          </th>
          {row.cells.map((cell) => (
            <td>
              {cell.length === 0 ? (
                <span aria-label="No value">–</span>
              ) : (
                cell.map((entry) => <ValueText entry={entry} blockId={blockId} differs={differing.has(entry.value)} />)
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<Footnotes notes={table.footnotes} blockId={blockId} label={label} />
