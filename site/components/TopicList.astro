---
import type { LoadedTopic } from '../../core/content/types';
import { withBase } from '../../core/site/base-path';
import { getContent } from '../lib/content';

interface Props {
  topics: LoadedTopic[];
}
const { topics } = Astro.props;
const { navigation } = getContent();
const base = import.meta.env.BASE_URL;
---

<ul class="topic-list">
  {topics.map((topic) => {
    const count = navigation.visibleLeafCount(topic.id);
    return (
      <li data-population={topic.population}>
        <a href={withBase(base, navigation.urlPath(topic.id))}>
          <span class="topic-list__title">{topic.title}</span>
          {!navigation.hasContent(topic.id) && (
            <span class="topic-list__meta">
              {count} {count === 1 ? 'topic' : 'topics'}
            </span>
          )}
        </a>
      </li>
    );
  })}
</ul>
