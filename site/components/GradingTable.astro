---
import type { LoadedBlock, LoadedValue } from '../../core/content/types';
import { buildGradingTable, buildNormalRangeTable } from '../../core/values/table';
import { getContent } from '../lib/content';
import ValueTable from './ValueTable.astro';

interface Props {
  block: Extract<LoadedBlock, { type: 'grading-table' | 'normal-range-table' }>;
  label: string;
  differing?: ReadonlySet<LoadedValue>;
  anchors?: ReadonlyMap<string, string>;
}
const { block, label, differing = new Set<LoadedValue>(), anchors = new Map<string, string>() } = Astro.props;
const { bundle } = getContent();
const table =
  block.type === 'grading-table'
    ? buildGradingTable(block, bundle.parameters)
    : buildNormalRangeTable(block, bundle.parameters);
---

<ValueTable table={table} label={label} blockId={block.id} differing={differing} anchors={anchors} />
