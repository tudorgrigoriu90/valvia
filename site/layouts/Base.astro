---
import '../styles/global.css';
import { withBase } from '../../core/site/base-path';
import Logo from '../components/Logo.astro';
import ReviewBanner from '../components/ReviewBanner.astro';
import { contentVersion } from '../../core/site/version';
import { CATEGORIES } from '../../core/population/category';
import { analyticsConfig, contentSecurityPolicy } from '../../core/site/analytics';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Echocardiography reference and cut-off values from ESC/EACVI and ASE documents.' } =
  Astro.props;
const base = import.meta.env.BASE_URL;
const version = contentVersion(process.env);
const builtOn = new Date().toISOString().slice(0, 10);
const analytics = analyticsConfig(process.env);
const csp = contentSecurityPolicy(analytics);
const pageTitle = title === 'Valvia' ? title : `${title} · Valvia`;
---

<!doctype html>
<html lang="en" data-base={base} data-category="adult">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <!-- Decision PO-3: draft content is not indexed until clinically reviewed. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <link rel="manifest" href={withBase(base, 'manifest.webmanifest')} />
    <link rel="icon" href={withBase(base, 'icon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#f6f7f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1217" media="(prefers-color-scheme: dark)" />
    <title>{pageTitle}</title>
    {import.meta.env.PROD && analytics !== undefined && (
      <script is:inline defer src={analytics.src} {...analytics.attributes} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="container">
        <a class="wordmark" href={withBase(base, '/')} aria-label="Valvia home">
          <Logo />
          <span>Valvia</span>
        </a>
        <div class="category-switch" role="group" aria-label="Category">
          {CATEGORIES.map(({ id, label }) => (
            <button type="button" data-category-choice={id} aria-pressed={id === 'adult' ? 'true' : 'false'}>
              {label}
            </button>
          ))}
        </div>
      </div>
    </header>
    <ReviewBanner />
    <p class="offline-indicator" role="status" data-offline-indicator hidden>
      <span class="container">Offline: showing saved content.</span>
    </p>
    <div class="update-prompt" role="status" data-update-prompt hidden>
      <div class="container">
        <span>New content available.</span>
        <button type="button">Refresh</button>
      </div>
    </div>
    <main id="main">
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>
          Valvia is a reference aid, not a medical device. Verify values against the original guideline before clinical
          use.
        </p>
        <p>Sources: European Society of Cardiology (incl. EACVI) and American Society of Echocardiography documents.</p>
        <p>
          <a href={withBase(base, 'about/')}>About Valvia: intended use and disclaimer</a> ·
          <a href={withBase(base, 'status/')}>Content status</a> ·<a href={withBase(base, 'whats-new/')}>What's new</a>{' '}
          ·<a href={withBase(base, 'privacy/')}>Privacy</a>
        </p>
        <p class="site-footer__version">
          Content version {version} · built {builtOn}
        </p>
      </div>
    </footer>
    <script>
      import '../scripts/register-sw';
      import '../scripts/offline-indicator';
      import '../scripts/category-switch';
      import '../scripts/recent-ui';
    </script>
  </body>
</html>
