{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valvia.invalid/schema/common.schema.json",
  "title": "Valvia shared definitions",
  "$defs": {
    "id": {
      "description": "Stable identifier: lowercase kebab-case, never changed or reused (ADR 0003).",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80,
      "x-format-name": "lowercase kebab-case"
    },
    "slug": {
      "description": "URL segment: lowercase kebab-case. May change; old slugs go to formerSlugs.",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80,
      "x-format-name": "lowercase kebab-case"
    },
    "text": {
      "description": "Non-empty single-line text.",
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[^\\n]*\\S[^\\n]*$",
      "x-format-name": "non-blank single-line text"
    },
    "longText": {
      "description": "Non-empty text that may span lines (notes, caveats).",
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S",
      "x-format-name": "non-blank text"
    },
    "population": {
      "description": "Population a node applies to (SME decision 1).",
      "enum": ["adult", "paediatric", "both"]
    },
    "wave": {
      "description": "Delivery wave (sequencing only; all content is P1).",
      "enum": ["W1", "W2"]
    },
    "locatorText": {
      "description": "Short locator label as printed in the source (kept as text so '1.10' stays '1.10').",
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\n]*\\S[^\\n]*$",
      "x-format-name": "non-blank single-line text"
    },
    "citation": {
      "description": "Where a value comes from: a registered source plus a locator inside it (TS-02.3.2). Every value has one.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "locator"],
      "properties": {
        "source": {
          "description": "Id of a registered source document.",
          "$ref": "#/$defs/id"
        },
        "locator": {
          "description": "Position in the source; at least one field is required.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "table": {
              "description": "Table number or label (e.g. '8', 'S3').",
              "$ref": "#/$defs/locatorText"
            },
            "figure": {
              "description": "Figure number or label (e.g. '2B').",
              "$ref": "#/$defs/locatorText"
            },
            "section": {
              "description": "Section number (e.g. '6.2.1').",
              "$ref": "#/$defs/locatorText"
            },
            "page": {
              "description": "Page (e.g. 'e45').",
              "$ref": "#/$defs/locatorText"
            }
          }
        }
      }
    },
    "modality": {
      "description": "Imaging modality (SME decision 4: CT and CMR values are included and badged).",
      "enum": ["Echo", "CT", "CMR"]
    },
    "unit": {
      "description": "Units as published in ESC/EACVI/ASE documents. '1' means dimensionless (ratios, scores). Display units follow NFR-15; conversions live in core/units.",
      "enum": [
        "1",
        "%",
        "mm",
        "cm",
        "mm/m²",
        "cm/m²",
        "mm²",
        "cm²",
        "cm²/m²",
        "mL",
        "mL/m²",
        "g",
        "g/m²",
        "g/m^2.7",
        "m/s",
        "cm/s",
        "m/s²",
        "mmHg",
        "ms",
        "s",
        "bpm",
        "mL/s",
        "AU",
        "°",
        "years"
      ]
    },
    "quantity": {
      "description": "Physical quantity of a parameter; decides the display unit (NFR-15) and which units a value may use.",
      "enum": [
        "dimensionless",
        "ratio",
        "percent",
        "length",
        "indexed-length",
        "area",
        "indexed-area",
        "volume",
        "indexed-volume",
        "mass",
        "indexed-mass",
        "velocity-blood",
        "velocity-tissue",
        "acceleration",
        "pressure",
        "time",
        "heart-rate",
        "flow-rate",
        "calcium-score",
        "angle",
        "age"
      ]
    },
    "populationQualifiers": {
      "description": "Who a value applies to (TS-02.2.5). ageGroup is mandatory so adult and paediatric values are never mixed (hazard log). Bands use inclusive min and exclusive max.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ageGroup"],
      "properties": {
        "ageGroup": {
          "description": "Population of this value: exactly one of adult or paediatric.",
          "enum": ["adult", "paediatric"]
        },
        "sex": {
          "description": "Sex-specific value; omit when the value applies to both sexes.",
          "enum": ["male", "female"]
        },
        "ageBand": {
          "description": "Age range the value applies to (min inclusive, max exclusive).",
          "type": "object",
          "additionalProperties": false,
          "required": ["unit"],
          "anyOf": [
            {
              "properties": {
                "min": true
              },
              "required": ["min"]
            },
            {
              "properties": {
                "max": true
              },
              "required": ["max"]
            }
          ],
          "properties": {
            "min": {
              "description": "Lower bound (inclusive).",
              "type": "number",
              "minimum": 0
            },
            "max": {
              "description": "Upper bound (exclusive).",
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "description": "Unit of the bounds.",
              "enum": ["days", "months", "years"]
            },
            "label": {
              "description": "Band label as printed in the source, e.g. '40–59 years'.",
              "$ref": "#/$defs/text"
            }
          }
        },
        "bsaBand": {
          "description": "Body surface area range in m² (DuBois), min inclusive, max exclusive.",
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            {
              "properties": {
                "min": true
              },
              "required": ["min"]
            },
            {
              "properties": {
                "max": true
              },
              "required": ["max"]
            }
          ],
          "properties": {
            "min": {
              "description": "Lower bound in m² (inclusive).",
              "type": "number",
              "minimum": 0
            },
            "max": {
              "description": "Upper bound in m² (exclusive).",
              "type": "number",
              "minimum": 0
            },
            "label": {
              "description": "Band label as printed in the source.",
              "$ref": "#/$defs/text"
            }
          }
        },
        "rhythm": {
          "description": "Rhythm-specific value (e.g. diastolic function in atrial fibrillation); omit when rhythm-independent.",
          "enum": ["sinus", "atrial-fibrillation"]
        },
        "zScoreReference": {
          "description": "Id of the cited z-score dataset (source of type z-score-dataset) a z-score value refers to. Shown as published; no patient z-score is computed.",
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
