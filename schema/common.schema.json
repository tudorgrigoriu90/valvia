{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valvia.invalid/schema/common.schema.json",
  "title": "Valvia shared definitions",
  "$defs": {
    "id": {
      "description": "Stable identifier: lowercase kebab-case, never changed or reused (ADR 0003).",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80,
      "x-format-name": "lowercase kebab-case"
    },
    "slug": {
      "description": "URL segment: lowercase kebab-case. May change; old slugs go to formerSlugs.",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80,
      "x-format-name": "lowercase kebab-case"
    },
    "text": {
      "description": "Non-empty single-line text.",
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[^\\n]*\\S[^\\n]*$",
      "x-format-name": "non-blank single-line text"
    },
    "longText": {
      "description": "Non-empty text that may span lines (notes, caveats).",
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S",
      "x-format-name": "non-blank text"
    },
    "population": {
      "description": "Population a node applies to (SME decision 1).",
      "enum": ["adult", "paediatric", "both"]
    },
    "wave": {
      "description": "Delivery wave (sequencing only; all content is P1).",
      "enum": ["W1", "W2"]
    },
    "locatorText": {
      "description": "Short locator label as printed in the source (kept as text so '1.10' stays '1.10').",
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\n]*\\S[^\\n]*$",
      "x-format-name": "non-blank single-line text"
    },
    "citation": {
      "description": "Where a value comes from: a registered source plus a locator inside it (TS-02.3.2). Every value has one.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "locator"],
      "properties": {
        "source": {
          "description": "Id of a registered source document.",
          "$ref": "#/$defs/id"
        },
        "locator": {
          "description": "Position in the source; at least one field is required.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "table": {
              "description": "Table number or label (e.g. '8', 'S3').",
              "$ref": "#/$defs/locatorText"
            },
            "figure": {
              "description": "Figure number or label (e.g. '2B').",
              "$ref": "#/$defs/locatorText"
            },
            "section": {
              "description": "Section number (e.g. '6.2.1').",
              "$ref": "#/$defs/locatorText"
            },
            "page": {
              "description": "Page (e.g. 'e45').",
              "$ref": "#/$defs/locatorText"
            }
          }
        }
      }
    },
    "modality": {
      "description": "Imaging modality (SME decision 4: CT and CMR values are included and badged).",
      "enum": ["Echo", "CT", "CMR"]
    },
    "technique": {
      "description": "Echocardiographic technique (decision PO-5): TTE (transthoracic, the default), TEE (transoesophageal) or stress (exercise or pharmacological stress echocardiography).",
      "enum": ["TTE", "TEE", "stress"]
    },
    "unit": {
      "description": "Units as published in ESC/EACVI/ASE documents. '1' means dimensionless (ratios, scores). Values are displayed in the published unit (decision PO-4); core/units converts only to compare values.",
      "enum": [
        "1",
        "%",
        "mm",
        "cm",
        "mm/m²",
        "cm/m²",
        "mm²",
        "cm²",
        "cm²/m²",
        "mL",
        "mL/m²",
        "g",
        "g/m²",
        "g/m^2.7",
        "g/m",
        "m/s",
        "cm/s",
        "m/s²",
        "cm/s²",
        "mmHg",
        "ms",
        "s",
        "bpm",
        "mL/s",
        "mL/min/kg",
        "AU",
        "°",
        "years",
        "mm/mmHg",
        "WU"
      ]
    },
    "quantity": {
      "description": "Physical quantity of a parameter; decides the common comparison unit and which units a value may use.",
      "enum": [
        "dimensionless",
        "ratio",
        "percent",
        "length",
        "indexed-length",
        "area",
        "indexed-area",
        "volume",
        "indexed-volume",
        "mass",
        "indexed-mass",
        "velocity-blood",
        "velocity-tissue",
        "velocity-time-integral",
        "acceleration",
        "pressure",
        "time",
        "heart-rate",
        "flow-rate",
        "calcium-score",
        "angle",
        "age",
        "coupling-ratio",
        "vascular-resistance",
        "mass-per-height",
        "indexed-flow-rate"
      ]
    },
    "populationQualifiers": {
      "description": "Who a value applies to (TS-02.2.5). ageGroup is mandatory so adult and paediatric values are never mixed (hazard log). Bands use inclusive min and exclusive max.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ageGroup"],
      "properties": {
        "ageGroup": {
          "description": "Population of this value: exactly one of adult or paediatric.",
          "enum": ["adult", "paediatric"]
        },
        "sex": {
          "description": "Sex-specific value; omit when the value applies to both sexes.",
          "enum": ["male", "female"]
        },
        "ageBand": {
          "description": "Age range the value applies to (min inclusive, max exclusive).",
          "type": "object",
          "additionalProperties": false,
          "required": ["unit"],
          "anyOf": [
            {
              "properties": {
                "min": true
              },
              "required": ["min"]
            },
            {
              "properties": {
                "max": true
              },
              "required": ["max"]
            }
          ],
          "properties": {
            "min": {
              "description": "Lower bound (inclusive).",
              "type": "number",
              "minimum": 0
            },
            "max": {
              "description": "Upper bound (exclusive).",
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "description": "Unit of the bounds.",
              "enum": ["days", "months", "years"]
            },
            "label": {
              "description": "Band label as printed in the source, e.g. '40–59 years'.",
              "$ref": "#/$defs/text"
            }
          }
        },
        "bsaBand": {
          "description": "Body surface area range in m² (DuBois), min inclusive, max exclusive.",
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            {
              "properties": {
                "min": true
              },
              "required": ["min"]
            },
            {
              "properties": {
                "max": true
              },
              "required": ["max"]
            }
          ],
          "properties": {
            "min": {
              "description": "Lower bound in m² (inclusive).",
              "type": "number",
              "minimum": 0
            },
            "max": {
              "description": "Upper bound in m² (exclusive).",
              "type": "number",
              "minimum": 0
            },
            "label": {
              "description": "Band label as printed in the source.",
              "$ref": "#/$defs/text"
            }
          }
        },
        "rhythm": {
          "description": "Rhythm-specific value (e.g. diastolic function in atrial fibrillation); omit when rhythm-independent.",
          "enum": ["sinus", "atrial-fibrillation"]
        },
        "zScoreReference": {
          "description": "Id of the cited z-score dataset (source of type z-score-dataset) a z-score value refers to. Shown as published; no patient z-score is computed.",
          "$ref": "#/$defs/id"
        }
      }
    },
    "value": {
      "description": "One published number (or range) for a parameter, with who it applies to and where it comes from (TS-02.2.2). Stored exactly as published.",
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "context", "operator", "unit", "modality", "population", "citation"],
      "properties": {
        "parameter": {
          "description": "Id of the parameter (content/parameters/<id>.yaml).",
          "$ref": "#/$defs/id"
        },
        "context": {
          "description": "What the value is used for: grading (GRADE), normal-range (NORM), intervention-threshold (INTV), feasibility (FEAS), diagnostic-criterion (CRIT), prognostic-marker (PROG).",
          "enum": [
            "grading",
            "normal-range",
            "intervention-threshold",
            "feasibility",
            "diagnostic-criterion",
            "prognostic-marker"
          ]
        },
        "grade": {
          "description": "Grade or category as printed, e.g. 'severe', 'moderate', 'favourable'. Required for grading and feasibility values.",
          "$ref": "#/$defs/text"
        },
        "operator": {
          "description": "Comparison as published. 'range' uses min and max; all others use value.",
          "enum": ["<", "<=", ">", ">=", "=", "range"]
        },
        "value": {
          "description": "The published number (single bound).",
          "type": "number"
        },
        "min": {
          "description": "Lower end of a published range.",
          "type": "number"
        },
        "max": {
          "description": "Upper end of a published range.",
          "type": "number"
        },
        "minExclusive": {
          "description": "Range only: the lower bound is exclusive (published as '> min'). Default: inclusive.",
          "type": "boolean"
        },
        "maxExclusive": {
          "description": "Range only: the upper bound is exclusive (published as '< max'). Default: inclusive.",
          "type": "boolean"
        },
        "unit": {
          "description": "Unit as published, also the unit displayed (decision PO-4).",
          "$ref": "#/$defs/unit"
        },
        "modality": {
          "description": "Modality the value was defined for (Echo, CT or CMR); CT/CMR values are badged (SME decision 4). Must be one of the parameter's modalities.",
          "$ref": "#/$defs/modality"
        },
        "technique": {
          "description": "TTE (default when absent), TEE or stress; TEE and stress values form their own categories on the site (decision PO-5). Only for modality Echo.",
          "$ref": "#/$defs/technique"
        },
        "population": {
          "$ref": "#/$defs/populationQualifiers"
        },
        "caveats": {
          "description": "Conditions and footnotes printed with the value, e.g. 'Not valid in atrial fibrillation.'",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/longText"
          }
        },
        "citation": {
          "$ref": "#/$defs/citation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "technique": {
                "enum": ["TEE", "stress"]
              }
            },
            "required": ["technique"]
          },
          "then": {
            "properties": {
              "modality": {
                "const": "Echo"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "context": {
                "enum": ["grading", "feasibility"]
              }
            },
            "required": ["context"]
          },
          "then": {
            "properties": {
              "grade": true
            },
            "required": ["grade"]
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "const": "range"
              }
            },
            "required": ["operator"]
          },
          "then": {
            "properties": {
              "min": true,
              "max": true,
              "value": false
            },
            "required": ["min", "max"]
          },
          "else": {
            "properties": {
              "value": true,
              "min": false,
              "max": false,
              "minExclusive": false,
              "maxExclusive": false
            },
            "required": ["value"]
          }
        }
      ]
    },
    "gradingTableBlock": {
      "description": "Severity grading table: one column per grade, in order.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "tag", "grades", "values"],
      "properties": {
        "id": {
          "description": "Anchor id of the block, unique within the topic (deep links, jump menu).",
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "grading-table"
        },
        "tag": {
          "description": "Taxonomy content tag.",
          "enum": ["GRADE"]
        },
        "title": {
          "description": "Heading shown above the block.",
          "$ref": "#/$defs/text"
        },
        "grades": {
          "description": "Grades in display order, from least to most severe (as printed).",
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "values": {
          "description": "Values shown in the block.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      }
    },
    "normalRangeTableBlock": {
      "description": "Normal reference ranges (sex/age/BSA specific via population qualifiers).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "tag", "values"],
      "properties": {
        "id": {
          "description": "Anchor id of the block, unique within the topic (deep links, jump menu).",
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "normal-range-table"
        },
        "tag": {
          "description": "Taxonomy content tag.",
          "enum": ["NORM"]
        },
        "title": {
          "description": "Heading shown above the block.",
          "$ref": "#/$defs/text"
        },
        "values": {
          "description": "Values shown in the block.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      }
    },
    "thresholdListBlock": {
      "description": "List of thresholds (intervention triggers, prognostic markers, criteria).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "tag", "values"],
      "properties": {
        "id": {
          "description": "Anchor id of the block, unique within the topic (deep links, jump menu).",
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "threshold-list"
        },
        "tag": {
          "description": "Taxonomy content tag.",
          "enum": ["INTV", "PROG", "CRIT"]
        },
        "title": {
          "description": "Heading shown above the block.",
          "$ref": "#/$defs/text"
        },
        "values": {
          "description": "Values shown in the block.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      }
    },
    "criteriaChecklistBlock": {
      "description": "Checklist of criteria, e.g. TEER feasibility (favourable / challenging / unsuitable).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "tag", "criteria"],
      "properties": {
        "id": {
          "description": "Anchor id of the block, unique within the topic (deep links, jump menu).",
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "criteria-checklist"
        },
        "tag": {
          "description": "Taxonomy content tag.",
          "enum": ["FEAS", "CRIT"]
        },
        "title": {
          "description": "Heading shown above the block.",
          "$ref": "#/$defs/text"
        },
        "criteria": {
          "description": "Criteria in display order.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "citation"],
            "properties": {
              "text": {
                "description": "Criterion as printed.",
                "$ref": "#/$defs/longText"
              },
              "category": {
                "description": "Feasibility category, when the source assigns one.",
                "enum": ["favourable", "challenging", "unsuitable"]
              },
              "values": {
                "description": "Numeric thresholds belonging to the criterion.",
                "type": "array",
                "items": {
                  "$ref": "#/$defs/value"
                }
              },
              "citation": {
                "$ref": "#/$defs/citation"
              }
            }
          }
        }
      }
    },
    "noteBlock": {
      "description": "Free-text note, e.g. measurement method or pitfalls.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "tag", "text"],
      "properties": {
        "id": {
          "description": "Anchor id of the block, unique within the topic (deep links, jump menu).",
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "note"
        },
        "tag": {
          "description": "Taxonomy content tag.",
          "enum": ["METH", "CRIT"]
        },
        "title": {
          "description": "Heading shown above the block.",
          "$ref": "#/$defs/text"
        },
        "text": {
          "description": "Note text.",
          "$ref": "#/$defs/longText"
        },
        "citation": {
          "$ref": "#/$defs/citation"
        }
      }
    },
    "algorithmReferenceBlock": {
      "description": "Link to an algorithm in the source document; never redrawn (SME decision 5).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "tag", "title", "citation"],
      "properties": {
        "id": {
          "description": "Anchor id of the block, unique within the topic (deep links, jump menu).",
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "algorithm-reference"
        },
        "tag": {
          "description": "Taxonomy content tag.",
          "enum": ["ALG"]
        },
        "title": {
          "description": "Heading shown above the block.",
          "$ref": "#/$defs/text"
        },
        "citation": {
          "$ref": "#/$defs/citation"
        },
        "url": {
          "description": "Direct https link to the algorithm, when available.",
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "x-format-name": "an https URL"
        }
      }
    },
    "block": {
      "description": "A content block on a leaf topic (TS-02.2.3). The type selects the block shape.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "description": "Block type.",
          "enum": [
            "grading-table",
            "normal-range-table",
            "threshold-list",
            "criteria-checklist",
            "note",
            "algorithm-reference"
          ]
        }
      },
      "discriminator": {
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/gradingTableBlock"
        },
        {
          "$ref": "#/$defs/normalRangeTableBlock"
        },
        {
          "$ref": "#/$defs/thresholdListBlock"
        },
        {
          "$ref": "#/$defs/criteriaChecklistBlock"
        },
        {
          "$ref": "#/$defs/noteBlock"
        },
        {
          "$ref": "#/$defs/algorithmReferenceBlock"
        }
      ]
    }
  }
}
