{
  "name": "valvia",
  "version": "0.0.0",
  "private": true,
  "description": "Quick lookup of echocardiography reference and cut-off values from ESC/EACVI and ASE documents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run validate:content && npm run build && npm run check:links -- --site && npm run test:e2e",
    "check:links": "tsx pipeline/links/cli.ts",
    "gen:types": "tsx pipeline/schema/cli.ts",
    "validate:content": "tsx pipeline/content/cli.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "astro": "7.4.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  }
}
